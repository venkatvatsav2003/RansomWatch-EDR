# RansomWatch EDR Configuration
# Copy to .env and customize

EDR_THRESHOLD=7.5
EDR_WARNING_THRESHOLD=6.5
EDR_POLL_INTERVAL=1.0
EDR_HONEYPOT_DIR=./honeypot
EDR_ALERT_LOG=logs/alerts.json
LOG_LEVEL=INFO

# Webhook alerts (optional)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_AUTH=

# Prometheus metrics (optional)
METRICS_ENABLED=false
METRICS_PORT=9100
